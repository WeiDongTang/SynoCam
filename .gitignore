# 根仓库忽略项
.DS_Store
*.log

# Flutter 工程（子目录内另有更细的 .gitignore）
synocam/.dart_tool/
synocam/.flutter-plugins
synocam/.flutter-plugins-dependencies
synocam/build/
synocam/.packages
synocam/pubspec.lock

# 生成的本地化代码（由 flutter gen-l10n 生成，不入库）
synocam/lib/l10n/app_localizations*.dart
synocam/.dart_tool/flutter_gen/

# iOS/Android 构建与签名产物
**/DerivedData/
**/*.xcarchive
**/build/
*.jks
*.keystore
*.mobileprovision

# 环境变量 / 密钥（绝不入库）
.env
*.env
**/key.properties

# 构建产物（由 CI artifact 分发，不入库）
*.ipa

# 旧的本地中间交付物（仅为一次性快照，不入库）
SynoCam-real-data.patch
SynoCam-real-data.zip
